# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated, e.g. yourname.pythonanywhere.com
ALLOWED_HOSTS=yourname.pythonanywhere.com

# Optional: use PythonAnywhere MySQL instead of SQLite
# DB_ENGINE=mysql
# DB_NAME=yourname$kinkylist
# DB_USER=yourname
# DB_PASSWORD=...
# DB_HOST=yourname.mysql.pythonanywhere-services.com
