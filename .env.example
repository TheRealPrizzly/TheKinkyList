# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated, e.g. yourname.pythonanywhere.com
ALLOWED_HOSTS=yourname.pythonanywhere.com
# Shown on the privacy page (required by the App Store and Google Play)
CONTACT_EMAIL=
# Push notifications: path to the Firebase service account key (JSON). Leave empty to turn push off.
# FCM_SERVICE_ACCOUNT_FILE=/home/yourname/firebase-service-account.json
# Sign in with Google: Firebase's "Web client" OAuth client (see the README). Leave empty to hide the Google buttons.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Optional: use PythonAnywhere MySQL instead of SQLite
# DB_ENGINE=mysql
# DB_NAME=yourname$kinkylist
# DB_USER=yourname
# DB_PASSWORD=...
# DB_HOST=yourname.mysql.pythonanywhere-services.com
